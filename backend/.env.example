# Copy to .env on the server. Never commit real values.
PORT=5006
NODE_ENV=production
API_PREFIX=/api
FRONTEND_URL=https://lab.anantasatriya.my.id
CORS_ORIGIN=https://lab.anantasatriya.my.id
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=20
JSON_BODY_LIMIT=1mb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kampungdigital
DB_USERNAME=kampungdigital_app
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace-only-if-using-compose-database
MYSQL_DATABASE=kampungdigital
MYSQL_USER=kampungdigital_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
